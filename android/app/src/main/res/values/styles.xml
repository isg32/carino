<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While Cariño starts (first launch, or a restart after a Material You
         change), Android's own wallpaper shows: the blurred copy Cariño keeps
         in sync, so a start looks like the wallpaper coming into focus. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <!-- No splash (starting window): it was a black flash. What was on
             screen stays until Cariño's first frame is ready. -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Behind the Flutter view once running: the same, never a flat colour. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
