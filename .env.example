# Copy to .env and fill in. .env is gitignored: never commit real values.
#
# CARINO_KEYSTORE_BASE64: base64 -w0 path/to/release-key.jks
CARINO_KEYSTORE_BASE64=
CARINO_KEYSTORE_PASSWORD=
# Optional: defaults to CARINO_KEYSTORE_PASSWORD.
CARINO_KEY_PASSWORD=
# Optional: defaults to "upload".
CARINO_KEY_ALIAS=upload
